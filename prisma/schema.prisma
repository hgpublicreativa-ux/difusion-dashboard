// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  // Optional: members can be imported first and get their email later
  email         String?  @unique
  password      String
  role          Role     @default(USER)
  team          Team     @default(TEAM1)
  driveFolderUrl String?
  phone          String?

  activityLogs ActivityLog[]
  phoneChanges PhoneChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([team])
}

enum Role {
  ADMIN
  USER
}

// Each member belongs to exactly one team; each team has its own form,
// dashboard and admin password
enum Team {
  TEAM1
  TEAM2
}

model GoogleAuthToken {
  id           String   @id @default(cuid())
  accountEmail String   @unique
  refreshToken String
  accessToken  String?
  expiryDate   BigInt?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ActivityLog {
  id                      String   @id @default(cuid())

  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date                    DateTime @default(now())

  // Campaign info
  campaignName            String

  // WhatsApp metrics
  whatsappGroupsReached   Int      @default(0)
  whatsappMessagesPerGroup Int     @default(0)
  whatsappPeopleReached   Int      @default(0)

  // Facebook metrics
  fbOwnPostsCreated       Int      @default(0)
  fbOwnPostsLinks         String[] @default([])
  fbCommentsMade          Int      @default(0)
  fbCommentLinks          String[] @default([])
  fbGroupsShared          Int      @default(0)
  fbNewGroupsJoined       Int      @default(0)
  fbPeopleMessaged        Int      @default(0)

  // TikTok metrics (Team 2). tiktokAccountsCommented always equals the
  // number of links in tiktokCommentLinks, kept as a column so it can be summed
  tiktokCommentsMade      Int      @default(0)
  tiktokCommentLinks      String[] @default([])
  tiktokAccountsCommented Int      @default(0)

  // Drive folder
  driveEvidenceFolderUrl  String?

  // Optional free-text notes from the member
  observations            String?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([campaignName])
}

// History of phone numbers assigned to a user by the admin
model PhoneChange {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  oldPhone  String?
  newPhone  String

  changedAt DateTime @default(now())

  @@index([userId])
}

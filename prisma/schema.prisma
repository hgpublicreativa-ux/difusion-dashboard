// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  role          Role     @default(USER)
  driveFolderUrl String?

  activityLogs ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
}

model GoogleAuthToken {
  id           String   @id @default(cuid())
  accountEmail String   @unique
  refreshToken String
  accessToken  String?
  expiryDate   BigInt?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ActivityLog {
  id                      String   @id @default(cuid())

  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date                    DateTime @default(now())

  // Campaign info
  campaignName            String

  // WhatsApp metrics
  whatsappGroupsReached   Int      @default(0)
  whatsappMessagesPerGroup Int     @default(0)

  // Facebook metrics
  fbOwnPostsCreated       Int      @default(0)
  fbOwnPostsLinks         String[] @default([])
  fbCommentsMade          Int      @default(0)
  fbGroupsShared          Int      @default(0)
  fbNewGroupsJoined       Int      @default(0)

  // Drive folder
  driveEvidenceFolderUrl  String?

  // Optional free-text notes from the member
  observations            String?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([campaignName])
}

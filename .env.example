# Database
DATABASE_URL="postgresql://user:password@localhost:5432/difusion_db"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-hex-32"
NEXTAUTH_URL="http://localhost:3000"

# Google Drive Service Account
# Download your service account JSON from Google Cloud Console
# Fill these values from the JSON file:
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL="your-service-account-email@project.iam.gserviceaccount.com"
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"
GOOGLE_DRIVE_PROJECT_ID="your-google-cloud-project-id"

# Drive Folder ID (create a folder in your Drive and get its ID from the URL)
# URL format: https://drive.google.com/drive/folders/FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID="your-main-folder-id-in-drive"

# Optional: Demo user credentials (for testing)
DEMO_USER_ID="user-demo-123"
DEMO_USER_NAME="Demo User"

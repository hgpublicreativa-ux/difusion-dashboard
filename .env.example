# Database
DATABASE_URL="postgresql://user:password@localhost:5432/difusion_db"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-hex-32"
NEXTAUTH_URL="http://localhost:3000"

# Google Drive OAuth (uploads files as a real Google account instead of a
# Service Account, which avoids the "Service Accounts do not have storage
# quota" error on personal Gmail accounts)
GOOGLE_OAUTH_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-oauth-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="https://your-app.railway.app/api/auth/google/callback"

# Drive Folder ID (create a folder in your Drive and get its ID from the URL)
# URL format: https://drive.google.com/drive/folders/FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID="your-main-folder-id-in-drive"

# Optional: Demo user credentials (for testing)
DEMO_USER_ID="user-demo-123"
DEMO_USER_NAME="Demo User"

# Copy to .env.local for local development. In Railway, set these under
# the service's Variables tab. Never commit real values.

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/difusion_db"

# Signs the session cookies (long random text, e.g. `openssl rand -hex 32`)
NEXTAUTH_SECRET="your-secret-key-here"

# Coordinator passwords: each one opens only its own team's panel
ADMIN_PASSWORD="choose-a-strong-team1-password"
ADMIN_PASSWORD_TEAM2="choose-a-strong-team2-password"

# Google Drive OAuth (uploads files as a real Google account). After
# deploying, open /api/auth/google once to connect the account.
GOOGLE_OAUTH_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-oauth-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="https://your-app.up.railway.app/api/auth/google/callback"

# Main Drive folder for evidence: the part after /folders/ in its URL
GOOGLE_DRIVE_FOLDER_ID="your-main-folder-id-in-drive"
